# ── Database ──────────────────────────────────────────────
# MongoDB Atlas or a local instance.
MONGODB_URI=mongodb://127.0.0.1:27017/azwah

# ── Auth ──────────────────────────────────────────────────
# Signs both the admin cookie and customer session cookies.
# Use a long random string. Changing it signs everyone out.
JWT_SECRET=change_me_to_a_long_random_string

# Admin panel credentials, checked directly by /api/admin/login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me

# ── Site ──────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, structured data and the sitemap.
NEXT_PUBLIC_SITE_URL=https://azwah.example.com
