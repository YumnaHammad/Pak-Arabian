# ─────────────────────────────────────────────────────────────
# TEMPLATE ONLY — never put real values in this file.
# It is tracked by git and pushed to GitHub. Copy it to `.env`
# (which is git-ignored) and fill the real values in there.
#
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# MongoDB Atlas connection string, or a local instance.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.mongodb.net/pakarabian?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────
# Signs the admin cookie and customer sessions. Use a long random
# string. Changing it signs everyone out.
JWT_SECRET=generate_a_long_random_string

# Admin panel login, checked by /api/admin/login.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# ── Order notification email (optional) ───────────────────
# Without these, orders still save normally — you simply get no alert.
# For Gmail you MUST use an App Password (Google Account → Security →
# 2-Step Verification → App passwords), never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_character_app_password
# Where the alert is delivered. Defaults to the house email.
ORDER_NOTIFY_TO=you@gmail.com

# ── Site ──────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs,
# Open Graph tags, structured data and the sitemap.
NEXT_PUBLIC_SITE_URL=https://pakarabian.example.com
